# PR-Agent environment example
# Copy this file to `.env` (or set these vars directly in Render Environment tab).
# IMPORTANT: Do not commit real secrets.

# =========================================================
# Shared settings
# =========================================================
OPENAI_KEY=<YOUR_OPENAI_API_KEY>
CONFIG_MODEL=gpt-5.3-codex
CONFIG_FALLBACK_MODELS=["gpt-5.2-codex"]

# Optional tuning
# CONFIG_LOG_LEVEL=INFO
# CONFIG_MAX_MODEL_TOKENS=32000

# =========================================================
# Service A: GitHub App webhook service
# Start command example:
# python -m pr_agent.servers.github_app
# =========================================================
CONFIG_GIT_PROVIDER=github
GITHUB_DEPLOYMENT_TYPE=app
GITHUB_APP_ID=<YOUR_GITHUB_APP_ID>

# Paste FULL PEM content including BEGIN/END lines.
# If your platform has trouble with multiline values, store with literal \n.
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n<YOUR_KEY_CONTENT>\n-----END RSA PRIVATE KEY-----"

# Must match the Webhook Secret configured in your GitHub App settings.
GITHUB_WEBHOOK_SECRET=<YOUR_GITHUB_WEBHOOK_SECRET>

# Optional GitHub settings
# GITHUB_BASE_URL=https://api.github.com
# GITHUB_APP_NAME=pr-agent

# =========================================================
# Service B: GitLab webhook service
# Start command example:
# python -m pr_agent.servers.gitlab_webhook
# =========================================================
# For GitLab deployment, set provider to gitlab in that service environment:
# CONFIG_GIT_PROVIDER=gitlab

# GitLab SaaS:
# GITLAB_URL=https://gitlab.com
# GitLab self-hosted example:
# GITLAB_URL=https://gitlab.your-company.com

# Personal Access Token from your GitLab bot account (scope: api)
GITLAB_PERSONAL_ACCESS_TOKEN=<YOUR_GITLAB_BOT_PAT>

# Must match X-Gitlab-Token value configured in GitLab project webhook
GITLAB_SHARED_SECRET=<YOUR_GITLAB_WEBHOOK_SECRET>

# Optional GitLab settings
# GITLAB_SSL_VERIFY=true
# GITLAB_IGNORE_MR_DRAFTS=true

# =========================================================
# Repo-level behavior (recommended to keep in each target repo)
# file: .pr_agent.toml
# =========================================================
# [github_app]
# handle_pr_actions = ["opened", "reopened", "ready_for_review"]
# pr_commands = ["/describe", "/review", "/improve"]
# handle_push_trigger = true
# push_commands = ["/review"]
#
# [gitlab]
# pr_commands = ["/describe", "/review", "/improve"]
# handle_push_trigger = true
# push_commands = ["/review"]
